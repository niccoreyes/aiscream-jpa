# Copy to .env, then edit. This file uses shell-compatible KEY=value syntax.
FHIR_PUBLIC_URL=https://phcore.thomasreyes.ph/fhir
FHIR_TESTER_NAME="PH Core"
LOCAL_HTTPS=true
# Set false for plain HTTP or an HTTPS proxy managed separately.
